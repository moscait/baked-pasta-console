{
  "name": "baked-pasta-console",
  "version": "0.2.0",
  "private": true,
  "description": "Baked Pasta Console: a drop-in OpenZiti Admin Console with the Access Canvas and guided service wizards",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:zac": "tsc -b && vite build --base=/zac/",
    "package:zac": "npm run build:zac && rm -f ziti-console.zip && cd dist && zip -r ../ziti-console.zip .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.78.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moscait/baked-pasta-console.git"
  },
  "homepage": "https://github.com/moscait/baked-pasta-console#readme",
  "bugs": {
    "url": "https://github.com/moscait/baked-pasta-console/issues"
  }
}
