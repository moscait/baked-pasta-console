{
  "name": "baked-pasta-console",
  "version": "0.1.0",
  "private": true,
  "description": "Baked Pasta Console: a drop-in OpenZiti Admin Console with the Access Canvas and guided service wizards",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:zac": "tsc -b && vite build --base=/zac/",
    "package:zac": "npm run build:zac && rm -f ziti-console.zip && cd dist && zip -r ../ziti-console.zip .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.2",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moscait/baked-pasta-console.git"
  },
  "homepage": "https://github.com/moscait/baked-pasta-console#readme",
  "bugs": {
    "url": "https://github.com/moscait/baked-pasta-console/issues"
  }
}
