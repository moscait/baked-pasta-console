// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`controller round-trip > applies form edits on top of the source 1`] = `
"# OpenZiti controller configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the controller.

v: 3

identity:
  cert: ./pki/ctrl-client.cert
  key: ./pki/ctrl-server.key
  ca: ./pki/cas.pem
  alt_server_certs:
    - server_cert: ./pki/alt.cert
      server_key: ./pki/alt.key

cluster:
  dataDir: /var/lib/ziti/cluster
  preferredLeader: true
  electionTimeout: 7s

ctrl:
  listener: tls:0.0.0.0:6262
  options:
    maxQueuedConnects: 2000
    newListener: tls:0.0.0.0:6263

network:
  cycleSeconds: 30

healthChecks:
  boltCheck:
    interval: 45s
    timeout: 20s

edge:
  api:
    address: ctrl1.example.com:1280
    sessionTimeout: 1h
  enrollment:
    signingCert:
      cert: ./pki/signing.cert
      key: ./pki/signing.key
    edgeIdentity:
      duration: 5h
  oidc:
    refreshTokenDuration: 48h
  authRateLimiter:
    enabled: false
    maxSize: 500

web:
  - name: public
    bindPoints:
      - interface: 0.0.0.0:1280
        address: ctrl1.example.com:1280
        newAddress: ctrl.example.com:1280
      - note: overlay
        identity:
          service: mgmt-api
          tlsClientAuthenticationPolicy: requireandverifyclientcert
          listenOptions:
            bindUsingEdgeIdentity: true
            connectTimeout: 5s
          file: /etc/ziti/overlay.json
    identity:
      cert: ./pki/web.cert
    options:
      idleTimeout: 5000ms
    apis:
      - binding: health-checks
      - binding: fabric
      - binding: edge-management
        options:
          pageSize: 100
      - binding: edge-client
      - binding: custom-thing
        options:
          x: 1

events:
  jsonLogger:
    subscriptions:
      - type: circuit
        include:
          - created
      - type: router
    handler:
      type: file
      format: json
      path: /var/log/ziti-events.log
      maxsizemb: 100
  amqp:
    subscriptions:
      - type: session
    handler:
      type: amqp
      url: amqp://localhost

customPlugin:
  enabled: true
  list:
    - 1
    - two
    - null
    - true
"
`;

exports[`controller round-trip > emits a fresh config, minimal and verbose > minimal 1`] = `
"# OpenZiti controller configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the controller.

v: 3

identity:
  cert: ./pki/ctrl-client/certs/ctrl-client.cert
  key: ./pki/ctrl-server/keys/ctrl-server.key
  ca: ./pki/cas.pem
  server_cert: ./pki/ctrl-server/certs/ctrl-server.chain.pem

db: ./data/ctrl.db

ctrl:
  listener: tls:0.0.0.0:6262

edge:
  api:
    address: localhost:1280
  enrollment:
    signingCert:
      cert: ./pki/signing/certs/signing.cert
      key: ./pki/signing/keys/signing.key

web:
  - name: client-management
    bindPoints:
      - interface: 0.0.0.0:1280
        address: localhost:1280
    apis:
      - binding: health-checks
      - binding: edge-management
      - binding: edge-client
      - binding: edge-oidc
"
`;

exports[`controller round-trip > emits a fresh config, minimal and verbose > verbose 1`] = `
"# OpenZiti controller configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the controller.

v: 3

identity:
  cert: ./pki/ctrl-client/certs/ctrl-client.cert
  key: ./pki/ctrl-server/keys/ctrl-server.key
  ca: ./pki/cas.pem
  server_cert: ./pki/ctrl-server/certs/ctrl-server.chain.pem

db: ./data/ctrl.db

ctrl:
  listener: tls:0.0.0.0:6262
  options:
    connectTimeoutMs: 1000
    maxQueuedConnects: 1000

network:
  cycleSeconds: 60
  routeTimeoutSeconds: 10
  createCircuitRetries: 2
  pendingLinkTimeoutSeconds: 10
  minRouterCost: 10
  routerConnectChurnLimit: 1m

healthChecks:
  boltCheck:
    interval: 30s

edge:
  api:
    address: localhost:1280
    sessionTimeout: 30m
  enrollment:
    signingCert:
      cert: ./pki/signing/certs/signing.cert
      key: ./pki/signing/keys/signing.key
    edgeIdentity:
      duration: 180m
    edgeRouter:
      duration: 180m
  oidc:
    accessTokenDuration: 30m
    refreshTokenDuration: 24h
  authRateLimiter:
    enabled: true
    maxSize: 250

web:
  - name: client-management
    bindPoints:
      - interface: 0.0.0.0:1280
        address: localhost:1280
    apis:
      - binding: health-checks
      - binding: edge-management
      - binding: edge-client
      - binding: edge-oidc
"
`;

exports[`controller round-trip > keeps an HA config with unmanaged content > minimal 1`] = `
"# OpenZiti controller configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the controller.

v: 3

trustDomain: example.ziti

identity:
  cert: ./pki/ctrl-client.cert
  server_cert: ./pki/ctrl-server.chain.pem
  key: ./pki/ctrl-server.key
  ca: ./pki/cas.pem
  alt_server_certs:
    - server_cert: ./pki/alt.cert
      server_key: ./pki/alt.key

cluster:
  dataDir: /var/lib/ziti/cluster
  preferredLeader: true
  electionTimeout: 7s

ctrl:
  listener: tls:0.0.0.0:6262
  options:
    advertiseAddress: tls:ctrl1.example.com:6262
    maxQueuedConnects: 2000
    newListener: tls:0.0.0.0:6263

network:
  cycleSeconds: 30
  smart:
    rerouteFraction: 0.05
    rerouteCap: 8

healthChecks:
  boltCheck:
    interval: 45s
    timeout: 20s

edge:
  api:
    address: ctrl1.example.com:1280
    sessionTimeout: 1h
  enrollment:
    signingCert:
      cert: ./pki/signing.cert
      key: ./pki/signing.key
    edgeIdentity:
      duration: 5h
  oidc:
    refreshTokenDuration: 48h
  totp:
    hostname: totp.example.com
  authRateLimiter:
    enabled: true
    maxSize: 500

web:
  - name: public
    bindPoints:
      - interface: 0.0.0.0:1280
        address: ctrl1.example.com:1280
        newAddress: ctrl.example.com:1280
      - note: overlay
        identity:
          service: mgmt-api
          tlsClientAuthenticationPolicy: requireandverifyclientcert
          listenOptions:
            bindUsingEdgeIdentity: true
            connectTimeout: 5s
          file: /etc/ziti/overlay.json
    identity:
      cert: ./pki/web.cert
    options:
      idleTimeout: 5000ms
    apis:
      - binding: health-checks
      - binding: edge-management
        options:
          pageSize: 100
      - binding: edge-client
      - binding: spa
        options:
          indexFile: index.html
          path: console
          location: /opt/console
      - binding: custom-thing
        options:
          x: 1

events:
  jsonLogger:
    subscriptions:
      - type: circuit
        include:
          - created
      - type: metrics
        sourceFilter: .*
      - type: entityChange
    handler:
      type: file
      format: json
      path: /var/log/ziti-events.log
      maxsizemb: 100
  amqp:
    subscriptions:
      - type: session
    handler:
      type: amqp
      url: amqp://localhost

customPlugin:
  enabled: true
  list:
    - 1
    - two
    - null
    - true
"
`;

exports[`controller round-trip > keeps an HA config with unmanaged content > verbose 1`] = `
"# OpenZiti controller configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the controller.

v: 3

trustDomain: example.ziti

identity:
  cert: ./pki/ctrl-client.cert
  server_cert: ./pki/ctrl-server.chain.pem
  key: ./pki/ctrl-server.key
  ca: ./pki/cas.pem
  alt_server_certs:
    - server_cert: ./pki/alt.cert
      server_key: ./pki/alt.key

cluster:
  dataDir: /var/lib/ziti/cluster
  preferredLeader: true
  electionTimeout: 7s
  snapshotInterval: 2m
  snapshotThreshold: 500
  heartbeatTimeout: 3s
  logLevel: info

ctrl:
  listener: tls:0.0.0.0:6262
  options:
    advertiseAddress: tls:ctrl1.example.com:6262
    maxQueuedConnects: 2000
    newListener: tls:0.0.0.0:6263
    connectTimeoutMs: 1000

network:
  cycleSeconds: 30
  smart:
    rerouteFraction: 0.05
    rerouteCap: 8
  routeTimeoutSeconds: 10
  createCircuitRetries: 2
  pendingLinkTimeoutSeconds: 10
  minRouterCost: 10
  routerConnectChurnLimit: 1m

healthChecks:
  boltCheck:
    interval: 45s
    timeout: 20s

edge:
  api:
    address: ctrl1.example.com:1280
    sessionTimeout: 1h
  enrollment:
    signingCert:
      cert: ./pki/signing.cert
      key: ./pki/signing.key
    edgeIdentity:
      duration: 5h
    edgeRouter:
      duration: 180m
  oidc:
    refreshTokenDuration: 48h
    accessTokenDuration: 30m
  totp:
    hostname: totp.example.com
  authRateLimiter:
    enabled: true
    maxSize: 500

web:
  - name: public
    bindPoints:
      - interface: 0.0.0.0:1280
        address: ctrl1.example.com:1280
        newAddress: ctrl.example.com:1280
      - note: overlay
        identity:
          service: mgmt-api
          tlsClientAuthenticationPolicy: requireandverifyclientcert
          listenOptions:
            bindUsingEdgeIdentity: true
            connectTimeout: 5s
          file: /etc/ziti/overlay.json
    identity:
      cert: ./pki/web.cert
    options:
      idleTimeout: 5000ms
    apis:
      - binding: health-checks
      - binding: edge-management
        options:
          pageSize: 100
      - binding: edge-client
      - binding: spa
        options:
          indexFile: index.html
          path: console
          location: /opt/console
      - binding: custom-thing
        options:
          x: 1

events:
  jsonLogger:
    subscriptions:
      - type: circuit
        include:
          - created
      - type: metrics
        sourceFilter: .*
      - type: entityChange
    handler:
      type: file
      format: json
      path: /var/log/ziti-events.log
      maxsizemb: 100
  amqp:
    subscriptions:
      - type: session
    handler:
      type: amqp
      url: amqp://localhost

customPlugin:
  enabled: true
  list:
    - 1
    - two
    - null
    - true
"
`;

exports[`controller round-trip > keeps an HA config with unmanaged content > warnings 1`] = `
