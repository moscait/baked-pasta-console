exports[`router round-trip > applies form edits in place 1`] = `
"# OpenZiti router configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the router.

v: 3

identity:
  cert: /etc/ziti/router.cert
  server_cert: /etc/ziti/router.server.cert
  key: /etc/ziti/router.key
  ca: /etc/ziti/ca.pem
  altServerCerts: []

ctrl:
  endpointsFile: /var/lib/ziti/endpoints.yml
  endpoints:
    - tls:ctrl1.example.com:6262

link:
  dialers:
    - binding: custom
  listeners:
    - binding: transport
      bind: tls:0.0.0.0:10080
      advertise: tls:er1.example.com:10080

listeners:
  - binding: edge
    address: tls:0.0.0.0:3022
    options:
      advertise: er1.example.com:3022
  - binding: tunnel
    options:
      mode: host
  - binding: edge_wss
    address: wss:0.0.0.0:3023

edge:
  csr:
    country: CA
    locality: Toronto
    organization: Example
    sans:
      dns:
        - localhost
        - er1.example.com

forwarder:
  latencyProbeInterval: 10

metrics:
  reportInterval: 30s

healthChecks:
  ctrlPingCheck:
    interval: 30s
    timeout: 15s

plugins:
  - name: example
"
`;

exports[`router round-trip > drops edge and tunnel listeners when turned off 1`] = `
"# OpenZiti router configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the router.

v: 3

identity:
  cert: /etc/ziti/router.cert
  server_cert: /etc/ziti/router.server.cert
  key: /etc/ziti/router.key
  ca: /etc/ziti/ca.pem
  altServerCerts: []

ctrl:
  endpointsFile: /var/lib/ziti/endpoints.yml
  endpoints:
    - tls:ctrl1.example.com:6262
    - tls:ctrl2.example.com:6262

link:
  dialers:
    - binding: transport
      groups:
        - east
      options:
        connectTimeout: 3s
    - binding: custom
  listeners:
    - binding: transport
      bind: tls:0.0.0.0:10080
      advertise: tls:er1.example.com:10080
      groups:
        - east
        - core
      options:
        outQueueSize: 64

listeners:
  - binding: edge_wss
    address: wss:0.0.0.0:3023

edge:
  csr:
    country: CA
    locality: Toronto
    organization: Example
    sans:
      dns:
        - localhost
        - er1.example.com
      ip:
        - 127.0.0.1

forwarder:
  latencyProbeInterval: 10
  xgressDialQueueLength: 1000

metrics:
  reportInterval: 30s

healthChecks:
  ctrlPingCheck:
    interval: 30s
    timeout: 15s
  linkCheck:
    minLinks: 1

plugins:
  - name: example
"
`;

exports[`router round-trip > emits a fresh router config in section order 1`] = `
"# OpenZiti router configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the router.

v: 3

identity:
  cert: ./pki/router/certs/client.cert
  server_cert: ./pki/router/certs/server.cert
  key: ./pki/router/keys/server.key
  ca: ./pki/router/cas.cert

ctrl:
  endpoint: tls:ctrl.example.com:6262
  endpointsFile: ./endpoints.yml

link:
  dialers:
    - binding: transport
  listeners:
    - binding: transport
      bind: tls:0.0.0.0:10080
      advertise: tls:router.example.com:10080

listeners:
  - binding: edge
    address: tls:0.0.0.0:3022
    options:
      advertise: router.example.com:3022

edge:
  csr:
    country: US
    province: NC
    locality: Charlotte
    organization: NetFoundry
    organizationalUnit: Ziti
    sans:
      dns:
        - localhost
        - router.example.com
      ip:
        - 127.0.0.1
        - "::1"
"
`;

exports[`router round-trip > keeps a fabric-only router’s top-level CSR 1`] = `
"# OpenZiti router configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the router.

v: 3

identity:
  cert: r.cert
  key: r.key
  ca: ca.pem

ctrl:
  endpoint: tls:ctrl.example.com:6262

link:
  dialers:
    - binding: transport

csr:
  country: US
  sans:
    dns:
      - fabric.example.com

listeners:
  - binding: tunnel
    options:
      mode: tproxy
"
`;

exports[`router round-trip > keeps an edge router with unmanaged content > unchanged 1`] = `
"# OpenZiti router configuration
# Generated by Baked Pasta Console Config Builder. Review before use; \${ENV_VARS} are expanded by the router.

v: 3

identity:
  cert: /etc/ziti/router.cert
  server_cert: /etc/ziti/router.server.cert
  key: /etc/ziti/router.key
  ca: /etc/ziti/ca.pem
  altServerCerts: []

ctrl:
  endpointsFile: /var/lib/ziti/endpoints.yml
  endpoints:
    - tls:ctrl1.example.com:6262
    - tls:ctrl2.example.com:6262

link:
  dialers:
    - binding: transport
      groups:
        - east
      options:
        connectTimeout: 3s
    - binding: custom
  listeners:
    - binding: transport
      bind: tls:0.0.0.0:10080
      advertise: tls:er1.example.com:10080
      groups:
        - east
        - core
      options:
        outQueueSize: 64

listeners:
  - binding: edge
    address: tls:0.0.0.0:3022
    options:
      advertise: er1.example.com:3022
      connectTimeoutMs: 5000
  - binding: tunnel
    options:
      mode: tproxy
      resolver: udp://127.0.0.1:53
      lanIf: eth0
  - binding: edge_wss
    address: wss:0.0.0.0:3023

edge:
  csr:
    country: CA
    locality: Toronto
    organization: Example
    sans:
      dns:
        - localhost
        - er1.example.com
      ip:
        - 127.0.0.1

forwarder:
  latencyProbeInterval: 10
  xgressDialQueueLength: 1000

metrics:
  reportInterval: 30s

healthChecks:
  ctrlPingCheck:
    interval: 30s
    timeout: 15s
  linkCheck:
    minLinks: 1

plugins:
  - name: example
"
`;

exports[`router round-trip > keeps an edge router with unmanaged content > warnings 1`] = `
[
  "kept non-transport link dialers as-is",
  "kept other listeners as-is: edge_wss",
  "passing through untouched: plugins",
]
`;
