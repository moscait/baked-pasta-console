FROM eclipse-temurin:25-jdk AS build

WORKDIR /app
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN ./mvnw dependency:go-offline -B

# vite.generated.ts is generated by the vaadin-maven-plugin during package, so it is not copied.
COPY package.json package-lock.json tsconfig.json types.d.ts vite.config.ts ./
COPY src src

RUN ./mvnw package -DskipTests -B

# Split the JAR into layers so dependencies get their own image layer.
RUN cp target/*.jar application.jar && \
    java -Djarmode=tools -jar application.jar extract --layers --destination extracted

FROM eclipse-temurin:25-jre-alpine
RUN addgroup -g 1001 -S app && adduser -u 1001 -S app -G app
USER 1001:1001
WORKDIR /application
COPY --from=build /app/extracted/dependencies/ ./
COPY --from=build /app/extracted/spring-boot-loader/ ./
COPY --from=build /app/extracted/snapshot-dependencies/ ./
COPY --from=build /app/extracted/application/ ./
EXPOSE 8080
# Let the heap use 75% of the container's memory limit instead of the default 25%.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "application.jar", "--spring.profiles.active=prod"]
